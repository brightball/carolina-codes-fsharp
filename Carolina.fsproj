<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- DB nulls are explicit. Reference nullness stays off so warn-as-error is the same on the SDK 8 image and newer compilers. -->
    <Nullable>disable</Nullable>
    <RootNamespace>Carolina</RootNamespace>
    <AssemblyName>Carolina</AssemblyName>
    <!-- The test project lives in this directory. Keep its restore output out of the app publish. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Carolina.Tests/**</DefaultItemExcludes>
    <RollForward>LatestMajor</RollForward>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Workstation GC fits a 512 MB shared-cpu Fly machine. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.6" />
  </ItemGroup>
</Project>
